# Local cloud development: use the database provider's public hostname and actual port.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://refunddesk_app:CHANGE_ME@db.example.com:5432/refunddesk_dev
DB_SSLMODE=verify-full
DB_SSL_ROOT_CERT=/absolute/path/to/provider-ca.pem
# Optional separate DDL account (defaults to DATABASE_URL for local bootstrap)
# MIGRATION_DATABASE_URL=postgresql+psycopg://refunddesk_ddl:CHANGE_ME@db.example.com:5432/refunddesk_dev
