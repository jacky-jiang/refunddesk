# AWS Lightsail PostgreSQL. Supply the actual IP and password in the environment.
APP_ENV=development
DB_HOST=
DB_PORT=5432
DB_NAME=helloagents
DB_SCHEMA=refunddesk
DB_USER=yijiang
DB_PASSWORD=
# No TLS/CA for the current deployment. Use require for TLS without CA verification.
DB_SSLMODE=disable
# For certificate verification: DB_SSLMODE=verify-full and DB_SSL_ROOT_CERT=/path/to/ca.pem
# Optional complete URL takes precedence over DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql+psycopg://USER:URI_ENCODED_PASSWORD@HOST:5432/helloagents
# Optional separate DDL account (defaults to DATABASE_URL for local bootstrap)
# MIGRATION_DATABASE_URL=postgresql+psycopg://DDL_USER:URI_ENCODED_PASSWORD@HOST:5432/helloagents
