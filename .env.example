# AWS Lightsail PostgreSQL. Supply the actual IP and password in the environment.
APP_ENV=development
DB_HOST=
DB_PORT=5432
DB_NAME=helloagents
DB_SCHEMA=refunddesk
DB_USER=yijiang
DB_PASSWORD=
# No TLS/CA for the current deployment. Use require for TLS without CA verification.
DB_SSLMODE=disable
# For certificate verification: DB_SSLMODE=verify-full and DB_SSL_ROOT_CERT=/path/to/ca.pem
# Optional complete URL takes precedence over DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql+psycopg://USER:URI_ENCODED_PASSWORD@HOST:5432/helloagents
# Optional separate DDL account (defaults to DATABASE_URL for local bootstrap)
# MIGRATION_DATABASE_URL=postgresql+psycopg://DDL_USER:URI_ENCODED_PASSWORD@HOST:5432/helloagents

# Browser origin behind HTTPS proxy; leave empty for direct localhost development.
# PUBLIC_ORIGIN=https://refunddesk.example.com
# Session cookies are Secure unless APP_ENV is development or test.

# Mock payment defaults to the same host/port/user/password and TLS settings as the
# business DB, but connects to refunddesk_payment and uses the refund schema.
# Override individual settings when the payment account or server differs.
PAYMENT_DB_NAME=refunddesk_payment
PAYMENT_DB_SCHEMA=refund
# PAYMENT_DB_HOST=
# PAYMENT_DB_PORT=5432
# PAYMENT_DB_USER=
# PAYMENT_DB_PASSWORD=
# PAYMENT_DB_SSLMODE=disable
# PAYMENT_DB_SSL_ROOT_CERT=/path/to/ca.pem
# A payment-specific URL takes precedence over the components above.
# PAYMENT_DATABASE_URL=postgresql+psycopg://PAYMENT_USER:URI_ENCODED_PASSWORD@HOST:5432/refunddesk_payment
# PAYMENT_SERVICE_TOKEN=replace-with-a-long-random-token
# PAYMENT_BASE_URL=http://127.0.0.1:8002
# WORKER_LEASE_SECONDS=30
# WORKER_RENEW_SECONDS=10
# PAYMENT_TIMEOUT_SECONDS=5
# Development/test only: PAYMENT_FAULT_MODE=drop_response
# Development/test only: PAYMENT_RESULT_MODE=succeeded  # or failed, pending
