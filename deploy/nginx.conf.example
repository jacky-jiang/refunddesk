# Host nginx; replace example hostname and certificate paths before nginx -t.
server {
    listen 443 ssl;
    server_name refunddesk.example.com;
    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
    }
    location = /health/live { proxy_pass http://127.0.0.1:8000; }
    # MCP remains loopback-only until I3 authorization is implemented.
}
